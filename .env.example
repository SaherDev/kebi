DATABASE_URL=
REDIS_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# OpenRouter — one key for the benchmark model matrix (ADR-173): Gemini,
# Qwen, DeepSeek, MiniMax etc. resolve through the OpenAI-compatible
# gateway at pass-through pricing. Optional: when unset, roles whose
# selected option uses provider `openrouter` cannot boot — leave those
# roles on their defaults. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Apify Personal API token — Google Maps shared-list import via the
# parseforge/google-maps-shared-list-scraper actor. Optional: when
# unset, Maps list URLs (maps.app.goo.gl/...) short-circuit silently
# with no candidates; the rest of extraction works normally. Get one
# free at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Brave Search API key — backs the `web_search` agent tool (ADR-145),
# which is how kebi answers anything the claims store does not already
# hold: event dates, schedules, prices, current conditions. Optional:
# when unset the tool stays bound and callable but returns empty, and
# the agent answers from what it knows rather than asserting a fact it
# could not check. Free tier at https://api-dashboard.search.brave.com
BRAVE_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# S3-compatible object storage for the extraction evidence ledger
# (ADR-093). Railway Object Storage today, swappable for AWS S3 /
# Cloudflare R2 / MinIO by changing BUCKET_ENDPOINT_URL only. Leave
# any of NAME / ACCESS_KEY_ID / SECRET_ACCESS_KEY unset and the
# service degrades to a no-op writer — safe for local dev / CI.
BUCKET_ENDPOINT_URL=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Optional. Railway / R2 accept "auto"; AWS S3 wants a real region like "us-east-1".
BUCKET_REGION=auto

# Gateway service-to-service auth. The NestJS gateway holds the same
# secret and signs every kebi call with X-Gateway-Token + the verified
# Clerk subject in X-Gateway-User-Id. Generate with `openssl rand -hex
# 32`. REQUIRED — kebi refuses to start without it.
GATEWAY_SHARED_SECRET=

# "production" disables /docs, /redoc, /openapi.json and locks CORS down
# to the explicit allowlist. Default "development" leaves docs exposed
# and CORS permissive for local tooling.
ENVIRONMENT=development

# Comma-separated origins permitted for the protected router. Empty =
# no cross-origin requests. Gateway calls are server-to-server and do
# not need CORS; this is for browser dev tooling only.
CORS_ALLOW_ORIGINS=

# Redact user content (message, intent, transcript, city) from
# Langfuse traces. true in production, may be flipped off in short
# dev-data debug sessions.
LANGFUSE_SCRUB_INPUT=true

# Feature flags
AGENT_ENABLED=true

# Orchestrator selection (ADR-068). Unset = use config/app.yaml
# `models.orchestrator.default`. Valid keys are the option names under
# `models.orchestrator` (e.g. claude-sonnet, claude-haiku, gpt-4o-mini).
# Unknown values log a warning and fall back to the default.
# AGENT_MODEL=
